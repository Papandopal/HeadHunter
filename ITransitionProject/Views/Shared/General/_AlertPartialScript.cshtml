@inject IConfiguration configuration;
@{
	string alertMessage = Context.Request.Cookies["Alert"] ?? "";
	string alertType = Context.Request.Cookies["AlertType"]?.ToLower() ?? "";
	bool hasAlert = !string.IsNullOrEmpty(alertMessage);

	if (hasAlert)
	{
		Context.Response.Cookies.Delete("Alert");
		Context.Response.Cookies.Delete("AlertType");
	}
}

@if (hasAlert)
{
	<script>
		addAlert();
		function addAlert() {
			let alertDiv = document.createElement('div');

			alertDiv.className = 'alert alert-@alertType';
			alertDiv.textContent = "@alertMessage";

			document.body.prepend(alertDiv);

			setTimeout(() => {
				alertDiv.remove();
			}, @configuration["AlertLifeTime"]);
		}
	</script>
}