@model EditAccessRulePartialDTO
@{
	string selectId = "selectId";
	string inputId = "inputId";
}
<label>@Model.AccessRule.Skill.Name:</label>
<select id="@selectId" onchange="@(Model.EventHandlers["AddAccessRuleRecord3"])('@Model.AccessRule.Skill.Id', 'Operator', this.value)">
	@foreach (var item in new List<FilterOperators> { FilterOperators.Equal, FilterOperators.NotEqual })
	{
		<!option @(item == Model.AccessRule.Operator ? "selected" : "") value="@item">@item</!option>
	}
</select>
<input id="@inputId" type="checkbox" @(Model.AccessRule.Value == "on" ? "checked" : "") onchange="@(Model.EventHandlers["AddAccessRuleRecord3"])('@Model.AccessRule.Skill.Id', 'Value', this.value)" />

<script>
	let selector = document.getElementById('@selectId');
	@(Model.EventHandlers["AddAccessRuleRecord3"])('@Model.AccessRule.Skill.Id', 'Operator', selector.value);
	let input = document.getElementById('@inputId');
	@(Model.EventHandlers["AddAccessRuleRecord3"])('@Model.AccessRule.Skill.Id', 'Value', input.value);
</script>