@model AddValuedSkillPartialDTO
@inject IConfiguration configuration
@{
	var imageRandomId = Guid.NewGuid().ToString();
}
<label for="@Model.Skill.Id">@Model.Skill.Name</label>
<img width="300" id="@imageRandomId" src="@configuration["ImageServices:EmptyImage"]" />
<input type="file" onchange="@(Model.EventHandlers["uploadImage3"])('@Model.Skill.Id', document.getElementById('@imageRandomId').src, this.files[0])" placeholder="@Model.Skill.PotentialValue" />
