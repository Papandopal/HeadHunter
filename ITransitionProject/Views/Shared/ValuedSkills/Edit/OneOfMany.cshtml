@model EditValuedSkillPartialDTO
@{

}
<label for="@Model.ValuedSkill.Id">@Model.ValuedSkill.Skill.Name</label>
<select id="@Model.ValuedSkill.Id" onchange="@(Model.EventHandlers["addUpdateInBuffer2"])(this.options[this.selectedIndex].text, '@Model.ValuedSkill.Id')">
	@foreach (var item in Model.ValuedSkill.Skill.PotentialValue.Split(";"))
	{
		@if (!string.IsNullOrEmpty(item))
		{
			<!option @(Model.ValuedSkill.Value == item ? "selected" : "")>@item</!option>
		}
	}
</select>