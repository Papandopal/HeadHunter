@model AddProjectPartialDTO
@{
	var titleInputId = Guid.NewGuid();
	var firstDateId = Guid.NewGuid();
	var secondDateId = Guid.NewGuid();
	var descriptionId = Guid.NewGuid();
	var projectTagsInputId = Guid.NewGuid();
	var addingProjectTagButtonId = Guid.NewGuid();
	var projectTagsSelectorId = Guid.NewGuid();
	var projectTagsTableId = Guid.NewGuid();
	var countOfPopularProjects = 10;
}
<div>
	<label for="@titleInputId">Title:</label>
	<input id="@titleInputId" required />
	<div class="d-flex flex-row">
		<label>Date Period</label>
		<input id="@firstDateId" type="date"/>
		<input id="@secondDateId" type="date" />
	</div>
	<div class="d-flex flex-column">
		<label>Description:</label>
		<textarea id="@descriptionId" required></textarea>
	</div>
	<input id="@projectTagsInputId" placeholder="Project Tags" />
	<button id="@addingProjectTagButtonId">Add</button>
	<select id="@projectTagsSelectorId">
	</select>
	<div id="@projectTagsTableId" />
</div>
<script>
	{
		let partsOfDatePeriod = ['', ''];

		document.getElementById('@titleInputId').oninput = function(){ 
			@(Model.EventsHandlers["addProjectRecord3"])('@Model.ProjectIndex', 'Title', this.value) 
		};

		document.getElementById('@firstDateId').onchange = function(){
			document.getElementById('@secondDateId').min = this.value;
			addDatePeriodRecord('@Model.ProjectIndex', 0, this.value)
		};

		document.getElementById('@secondDateId').onchange = function(){
			document.getElementById('@firstDateId').max = this.value;
			addDatePeriodRecord('@Model.ProjectIndex', 1, this.value)
		};

		document.getElementById('@descriptionId').oninput = function(){
			@(Model.EventsHandlers["addProjectRecord3"])('@Model.ProjectIndex', 'Description', this.value)
		};

		document.getElementById('@projectTagsInputId').oninput = function(){
			loadProjectTags(this.value)
		};

		document.getElementById('@addingProjectTagButtonId').onclick = function(){
			addTagByButton(document.getElementById('@projectTagsInputId').value)
		};

		document.getElementById('@projectTagsSelectorId').onchange = function(){
			addTagBySelector(this.value)
		};

		loadPopularProjectTags('@countOfPopularProjects');

		function addDatePeriodRecord(projectIndex, index, value){
			partsOfDatePeriod[index] = value;
			if(partsOfDatePeriod[0] !== '' && partsOfDatePeriod[1] !== ''){
				@(Model.EventsHandlers["addProjectRecord3"])(projectIndex, 'DatePeriod', partsOfDatePeriod.join('@Separators.DatePeriodSeparator'));
			}
		}

		function updateProjectTagSelector(data){
			let select = document.getElementById('@projectTagsSelectorId');
			let selectedTags = [...document.getElementById('@projectTagsTableId').getElementsByTagName('label')].map(x=>x.textContent);
			let filteredData = [];

			for(item of data){
				if(typeof(selectedTags.find(x=>x === item)) === 'undefined'){
					filteredData.push(item);
				}
			}

			select.innerHTML = '<option selected hidden disabled>Project tags</option>' + filteredData
			.map(item => `<option value="${item}">${item}</option>`)
			.join('');
		}

		function loadPopularProjectTags(limit){
			fetch(`/@Model.ControllerForGetPopularProjectTags/@Model.ActionForGetPopularProjectTags?limit=${encodeURIComponent(limit)}`,  {
				method: 'GET',
				headers: {
					'Accept': 'application/json'
				}
			})
			.then(response => response.json())
			.then(data=>{
				updateProjectTagSelector(data);
			})
			.catch(error=>console.error(error));
		}

		function loadProjectTags(prefix){
			fetch(`/@Model.ControllerForGetProjectTags/@Model.ActionForGetProjectTags?prefix=${encodeURIComponent(prefix)}`,  {
				method: 'GET',
				headers: {
					'Accept': 'application/json'
				}
			})
			.then(response => response.json())
			.then(data=>{
				updateProjectTagSelector(data);
			})
			.catch(error=>console.error(error));
		}

		function removeTag(id, tag){
			document.getElementById(id).remove();
			let newOption = document.createElement('option');
			newOption.value = tag;
			newOption.text = tag;
			document.getElementById('@projectTagsSelectorId').append(newOption);
			@(Model.EventsHandlers["removeProjectTag2"])('@Model.ProjectIndex', tag);
		}

		function addTag(tag){
			let newDiv = document.createElement('div');
			newDiv.id = crypto.randomUUID();
			newDiv.classList.add('border');
			let newLabel = document.createElement('label');
			newLabel.textContent = tag;
			let newButton = document.createElement('button');
			newButton.textContent = '-';
			newButton.classList.add('btn');
			newButton.classList.add('btn-sm');
			newButton.classList.add('btn-outline-danger');
			newButton.onclick = function(){
				removeTag(newDiv.id, tag);
			};

			newDiv.append(newLabel, newButton);
			document.getElementById('@projectTagsTableId').append(newDiv);
		}

		function addTagBySelector(tag){
			addTag(tag);
			@(Model.EventsHandlers["addProjectTag2"])('@Model.ProjectIndex', tag);
			document.getElementById('@projectTagsSelectorId').querySelector(`option:checked`).remove();
		}

		function addTagByButton(tag){
			addTag(tag);
			@(Model.EventsHandlers["addProjectTag2"])('@Model.ProjectIndex', tag);
			document.getElementById('@projectTagsInputId').value = '';
		}
	}
</script>