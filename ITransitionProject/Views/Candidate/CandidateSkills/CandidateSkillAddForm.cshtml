@model AddCandidateSkillFormPageDTO
@{
	string bufferInputName = "buffer";
	string buttonForSubmitId = "buttonForSubmitId";
	Model.EventsHandlers.Add("onTextChanged2", "onTextChanged2");
	Model.EventsHandlers.Add("addUpdateInBuffer2", "addUpdateInBuffer2");
	Model.EventsHandlers.Add("addDatePeriodUpdateInBuffer3", "addDatePeriodUpdateInBuffer3");

	var partialModel = new AddValuedSkillPartialDTO
			{
				EventHandlers = Model.EventsHandlers,
				Skill = Model.Skill
			};
}
<div class="w-100 h-100">
	<label for="@Model.Skill.Id">@Model.Skill.Name: </label>
	<partial name="ValuedSkills/Add/@Model.Skill.Type.ToString()" model="@partialModel" />

	<form asp-action="@Model.ActionForSubmit" asp-controller="@Model.ControllerForSubmit" onsubmit="saveBufferInHiddenInput()" method="post">
		<input id="@bufferInputName" name="@bufferInputName" type="hidden" value="{}" />
		<button id="@buttonForSubmitId" type="submit" disabled> Save</button>
	</form>

</div>

<script>
	let countOfRequiredProperties = @Model.CountOfRequiredProperties;
	if(countOfRequiredProperties == 0) activateSubmitButton();
	let buffer = [];
	let timeout = null;
	let partsOfPeriod = ['', ''];

	function activateSubmitButton(){
		document.getElementById("@buttonForSubmitId").disabled = false;
	}

	function onTextChanged2(newValue, skillId) {
		clearTimeout(timeout);

		timeout = setTimeout(() => {

			addUpdateInBuffer2(newValue, skillId)

		}, 500);
	}

	function saveBufferInHiddenInput(){
		document.getElementById("@bufferInputName").value = JSON.stringify(buffer);
	}

	function addDatePeriodUpdateInBuffer3(newValue, index, skillId){
		let item = buffer.find(item=>item.SkillId === skillId);
		if(typeof item !== 'undefined'){
			if(partsOfPeriod[index] === '') countOfRequiredProperties--;
			partsOfPeriod[index] = newValue;
			item.Value = partsOfPeriod.join(';');
			if(countOfRequiredProperties == 0) activateSubmitButton();
		}
		else{
			partsOfPeriod[index] = newValue;
			let currentData = {
				SkillId: skillId,
				Value: partsOfPeriod.join(';')
			};
			buffer.push(currentData);
		}
	}

	function addUpdateInBuffer2(newValue, skillId) {

		let currentData = {
			SkillId: skillId,
			Value: newValue
		};

		let item = buffer.find(item=>item.SkillId === skillId);
		if(typeof item !== 'undefined'){
			item.value = newValue;
		}
		else{
			countOfRequiredProperties--;
			buffer.push(currentData);
			if(countOfRequiredProperties == 0) activateSubmitButton();
		}
	}
</script>