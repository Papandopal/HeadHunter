@model ViewCVPageDTO
@{

}

<div class="container">
	<div class="row">
		<div class="col-3">
			<div class="container">
				@foreach (var skill in Model.CV.ValuedSkills)
				{
					<div class="row">
						<div class="col-12">
							<label>@skill.Skill.Name: @skill.Value</label>
						</div>
					</div>
				}
			</div>
		</div>
		<div class="col-9">
			<div class="container">
				@foreach (var project in Model.CV.Candidate.Projects)
				{
					<div class="row">
						<div class="col-3">
							<label>@DatePeriodFormater.Render(project.DatePeriod)</label>
						</div>
						<div class="col-9">
							<label>@project.Title</label>
							@Html.Raw(MarkdownTextFormater.Render(project.Description))
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>
