@using ITransitionProject.PagesDTOs.Candidate.CandidateSkills
@model ViewCandidateSkillsPageDTO
@{
	IEnumerable<ViewValuedSkillPartialDTO> partialDTOs = Model.CandidateSkills
	.Select(x => new ViewValuedSkillPartialDTO
			{//mapper
				ValuedSkill = new ValuedSkillDTO{ Id = x.Id, Skill = x.Skill, Value = x.Value}
			});
}
<div class="w-100 h-100">
	@foreach(var partialDTO in partialDTOs)
	{
		<partial name="ValuedSkills/View/@partialDTO.ValuedSkill.Skill.Type" model="@partialDTO"/>
	}
</div>