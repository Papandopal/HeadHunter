@model ViewReadOnlyPositionPageDTO
@inject IMarkdownTextFormater markdownTextFormater
@inject IUILocalizationFormater UILocalizationFormater
@{

}
<div class="row">
	<label>@UILocalizationFormater.Format("Title"): @Model.Position.Title</label>
	<label>@UILocalizationFormater.Format("Description")</label>
	<div>
		@Html.Raw(markdownTextFormater.Format(Model.Position.Description))
	</div>
	<table>
		<tbody>
			<tr>
				<td>
					<label>@UILocalizationFormater.Format("Skills"):</label>
					@foreach (var skill in Model.Position.PositionSkills)
					{
						<partial name="Skills/View/@skill.Skill.Type" model="new ViewSkillPartialDTO{ Skill = skill.Skill}" />
					}
				</td>
			</tr>
			<tr>
				<td>
					<label>@UILocalizationFormater.Format("Access Rules(Filters)"):</label>
					@foreach (var rule in Model.Position.AccessRules)
					{
						<partial name="AccessRules/View/@rule.Skill.Type" model="new ViewAccessRulePartialDTO{ AccessRule = rule}" />
					}
				</td>
			</tr>
			<tr>
				<td>
					<div>
						<label>@UILocalizationFormater.Format("Max count of projects"): @Model.Position.MaxCountOfProject</label>
					</div>
					<label>@UILocalizationFormater.Format("Project tags"):</label>
					@foreach (var projectTag in Model.Position.ProjectTags)
					{
						<label>@projectTag.Name</label>
					}
				</td>
			</tr>
		</tbody>

	</table>
	<a class="btn" type="submit" asp-controller="@Model.ControllerForGenerateCV" asp-action="@Model.ActionForGenerateCV" asp-route-positionId="@Model.Position.Id">@UILocalizationFormater.Format("Generate CV")</a>
</div>
