@model EditProjectFormPageDTO
@{
	var dto = new EditProjectPartialDTO
			{
				ProjectIndex = Model.ProjectIndex,
				Project = Model.Project,
				EventsHandlers = Model.EventsHandlers,
				ActionForGetProjectTags = Model.ActionForGetProjectTags,
				ControllerForGetProjectTags = Model.ControllerForGetProjectTags
			};
}
<div id="@Model.ProjectIndex" class="w-100 h-100 position-relative">
	<partial name="Projects/EditProject" model="@dto" />
	<button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0" onclick="@(Model.EventsHandlers["removeProject1"])('@Model.ProjectIndex')">-</button>
</div>
