@model EditCandidateSkillsAndProjectsPageDTO
@{
	string bufferInputName = "buffer";
	string buttonForSubmitId = "buttonForSubmitId";

	Model.EventHandlers.Add("onTextChanged2", "onTextChanged2");
	Model.EventHandlers.Add("addUpdateInBuffer2", "addUpdateInBuffer2");
	Model.EventHandlers.Add("addDatePeriodUpdateInBuffer3", "addDatePeriodUpdateInBuffer3");

	IEnumerable<EditValuedSkillPartialDTO> partialDTOs = Model.CandidateSkills.Select(x =>
	{
		//mapper
		return new EditValuedSkillPartialDTO
				{
					EventHandlers = Model.EventHandlers,
					ValuedSkill = new ValuedSkillDTO
					{
						Id = x.Id,
						Skill = x.Skill,
						Value = x.Value
					}
				};
	});
}
<div class="w-100 h-100">

	@foreach (var partialDTO in partialDTOs)
	{
		<partial name="ValuedSkills/Edit/@partialDTO.ValuedSkill.Skill.Type.ToString()" model="@partialDTO" />
	}

	<form asp-action="@Model.ActionToSubmit" asp-controller="@Model.ControllerToSubmit" onsubmit="saveBufferInHiddenInput()" method="post">
		<input type="hidden" id="@bufferInputName" name="json" value="{}" />
		<button id="@buttonForSubmitId" type="submit" disabled onsubmit="saveBufferInHiddenInput()"> Save</button>
	</form>

</div>

<script>
	let buffer = [];
	let countOfRequiredProperties = @Model.CountOfRequiredProperties;
	if(countOfRequiredProperties == 0) activateSubmitButton();
	let timeout = null;

	function activateSubmitButton(){
		document.getElementById("@buttonForSubmitId").disabled = false;
	}

	function onTextChanged2(newValue, skillId) {
		clearTimeout(timeout);

		timeout = setTimeout(() => {

			addUpdateInBuffer2(newValue, skillId)

		}, 500);
	}

	function saveBufferInHiddenInput(){
		let input = document.getElementById('@bufferInputName');
		input.value = JSON.stringify(buffer);
	}

	function addDatePeriodUpdateInBuffer3(newValue, index, skillId){

		let item = buffer.find(item=>item.ValuedSkillId === skillId);
		if(typeof item !== 'undefined'){
			let parts = item.value.split('@Separators.DatePeriodSeparator');
			parts[index] = newValue;
			item.value = parts.join('@Separators.DatePeriodSeparator');
		}
		else{
			if(index!=0) newValue = '@Separators.DatePeriodSeparator'+newValue;
			let currentData = {
				ValuedSkillId: skillId,
				Value: newValue
			};
			countOfRequiredProperties--;
			buffer.push(currentData);
			if(countOfRequiredProperties == 0) activateSubmitButton();
		}
	}

	function addUpdateInBuffer2(newValue, skillId) {

		let currentData = {
			ValuedSkillId: skillId,
			Value: newValue
		};

		let item = buffer.find(item=>item.ValuedSkillId === skillId);
		if(typeof item !== 'undefined'){
			item.value = newValue;
		}
		else{
			countOfRequiredProperties--;
			buffer.push(currentData);
			if(countOfRequiredProperties == 0) activateSubmitButton();
		}
	}
</script>