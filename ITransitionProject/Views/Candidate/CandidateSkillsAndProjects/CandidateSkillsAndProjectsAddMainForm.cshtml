@model AddCandidateSkillsAndProjectsPageDTO
@{
	string bufferForSkills = nameof(Model.PostedModel.BufferForSkills);
	string bufferForProjects = nameof(Model.PostedModel.BufferForProjects);
	string buttonForSubmitId = "buttonForSubmitId";
	string CandidateSkillTypeSelectorId = "CandidateSkillTypeSelector";
	string CandidateSkillFormsId = "CandidateSkillFormId";
	string CandidateProjectFormsId = "CandidateProjectFormsId";
}
<div class="container">
	<div class="row">
		<div class="col">
			<input type="text" oninput="loadSkills(this.value)" />
			<select id="@CandidateSkillTypeSelectorId" onchange="loadForm(this.value)">
				<option hidden disabled selected>Элементы</option>
			</select>
			<div id="@CandidateSkillFormsId">
			</div>
		</div>
		<div class="col">
			<div id="@CandidateProjectFormsId">
			</div>
		</div>
	</div>
</div>


<form asp-controller="@Model.ControllerForSubmit" asp-action="@Model.ActionForSubmit" onsubmit="saveBufferInHiddenInput()" method="post">
	<input id="@bufferForSkills" name="@bufferForSkills" type="hidden"/>
	<input id="@bufferForProjects" name="@bufferForProjects" type="hidden"/>
	<button id="@buttonForSubmitId" type="submit"> Save</button>
</form>

<script>
	function saveBufferInHiddenInput(){
		document.getElementById("@bufferForSkills").value = JSON.stringify(bufferForSkills);
		document.getElementById("@bufferForProjects").value = JSON.stringify(bufferForProjects);;
	}

	function activateSubmitButton(){
		document.getElementById("@buttonForSubmitId").disabled = false;
	}

	function deactivateSubmitButton(){
		document.getElementById("@buttonForSubmitId").disabled = true;
	}

	function executeScriptsInContainer(container) {
		const scripts = container.querySelectorAll('script');

		scripts.forEach(oldScript => {
			const newScript = document.createElement('script');

			for (let attr of oldScript.attributes) {
				newScript.setAttribute(attr.name, attr.value);
			}
			if (oldScript.textContent) {
				newScript.textContent = oldScript.textContent;
			}
			oldScript.parentNode.replaceChild(newScript, oldScript);
		});
	}
</script>

<script>
	class ProjectRecord{
		ProjectIndex;
		PropName;
		PropValue;
		constructor(projectIndex, propName, propValue){
			this.ProjectIndex = projectIndex;
			this.PropName = propName;
			this.PropValue = propValue;
		}
	}
	let bufferForProjects = [];
	let countOfRequiredProjectProperties = @typeof(AddProjectDTO).GetProperties().Length - 1;
	let projectIndex = 0;
	let projectIndexes = [];

	addProject();

	function addProject(){
		
		fetch(`/@Model.ControllerForGetProjectForm/@Model.ActionForGetProjectForm?projectIndex=${projectIndex}`)
		.then(response => response.text())
		.then(html => {
			let form = document.getElementById("@CandidateProjectFormsId");
			let newDiv = document.createElement('div');
			newDiv.innerHTML = html;
			form.append(newDiv);
			projectIndexes.push(projectIndex);
			projectIndex++;
			countOfRequiredProjectProperties = @typeof(AddProjectDTO).GetProperties().Length - 1;
			executeScriptsInContainer(form);
		})
		.catch(error => console.log('Error:', error));
	}

	function removeProject1(projectIndex)
	{
		bufferForProjects = bufferForProjects.filter(x=>x.ProjectIndex !== projectIndex);
		if(String(projectIndexes[projectIndexes.length-1]) === projectIndex){
			let inputs = document.getElementById(projectIndex).getElementsByTagName('input');
			for(let item of inputs){
				item.value = '';
			}
		}
		else{
			document.getElementById(projectIndex).remove();
			projectIndexes = projectIndexes.filter(x=>x !== Number(projectIndex));
		}
		countOfRequiredProjectProperties = @typeof(AddProjectDTO).GetProperties().Length - 1;
	}

	function addProjectRecord3(projectIndex, propName, propValue){
		let item = bufferForProjects.find(x=>x.ProjectIndex === projectIndex && x.PropName === propName);
		if(typeof(item) !== 'undefined'){
			item.PropValue = propValue;
		}
		else{
			bufferForProjects.push(new ProjectRecord(projectIndex, propName, propValue));
			if(propName !== 'ProjectTags') countOfRequiredProjectProperties--;
			if(countOfRequiredProjectProperties === 0) addProject();
		}
	}

	function addProjectTag2(projectIndex, tag){
		let item = bufferForProjects.find(x=>x.ProjectIndex === projectIndex && x.PropName === 'ProjectTags');
		if(typeof(item) !== 'undefined')
		{
			item.PropValue += '@Separators.ProjectTagsSeparator' + tag;
		}
		else{
			bufferForProjects.push(new ProjectRecord(projectIndex, 'ProjectTags', tag));
		}
	}

	function removeProjectTag2(projectIndex, tag){
		let item = bufferForProjects.find(x=>x.ProjectIndex === projectIndex && x.PropName === 'ProjectTags');
		let tags = item.PropValue.split('@Separators.ProjectTagsSeparator');
		tags = tags.filter(x=>x !== tag);
		item.PropValue = tags.join('@Separators.ProjectTagsSeparator');
	}
</script>

<script>
    let countOfRequiredSkills = 0;
    let bufferForSkills = [];
	let selectedSkills = [];
    let timeout = null;
    let partsOfPeriod = ['', ''];

	function onTextChanged2(newValue, skillId) {
		clearTimeout(timeout);

		timeout = setTimeout(() => {

			addUpdateInBuffer2(newValue, skillId)

		}, 500);
	}

	function addDatePeriodUpdateInBuffer3(newValue, index, skillId){
		let item = bufferForSkills.find(item=>item.SkillId === skillId);
		if(typeof item !== 'undefined'){
			if(partsOfPeriod[index] === '') countOfRequiredSkills--;
			partsOfPeriod[index] = newValue;
			item.Value = partsOfPeriod.join('@Separators.DatePeriodSeparator');
			if(countOfRequiredSkills == 0) activateSubmitButton();
		}
		else{
			partsOfPeriod[index] = newValue;
			let currentData = {
				SkillId: skillId,
				Value: partsOfPeriod.join('@Separators.DatePeriodSeparator')
			};
			bufferForSkills.push(currentData);
		}
	}

	function addUpdateInBuffer2(newValue, skillId) {

		let currentData = {
			SkillId: skillId,
			Value: newValue
		};

		let item = bufferForSkills.find(item=>item.SkillId === skillId);
		if(typeof item !== 'undefined'){
			item.value = newValue;
		}
		else{
			countOfRequiredSkills--;
			bufferForSkills.push(currentData);
			if(countOfRequiredSkills == 0) activateSubmitButton();
		}
	}

	function removeSkill2(skillId, skillName)
	{
		bufferForSkills = bufferForSkills.filter(x=>x.SkillId !== skillId);
		selectedSkills = selectedSkills.filter(x=>x != skillName);
		document.getElementById(skillId).remove();
		let skillsSelector = document.getElementById('@CandidateSkillTypeSelectorId');
		let newOption = document.createElement('option');
		newOption.value = skillName;
		newOption.textContent = skillName;
		skillsSelector.append(newOption);
	}

	function loadSkills(prefix){
        fetch(`/@Model.ControllerForGetSkillsNames/@Model.ActionForGetSkillsNames?prefix=${encodeURIComponent(prefix)}`, {
			method: 'GET',
			headers: {
				'Accept': 'application/json'
			}
		})
		.then(response => response.json())
		.then(data=>{
			let select = document.getElementById('@CandidateSkillTypeSelectorId');

			data = data.filter(x=>selectedSkills.indexOf(x) === -1);

			select.innerHTML = '<option hidden disapbled selected value="">Элементы</option>' + data
			.map(item => `<option value="${item}">${item}</option>`)
			.join('');
		})
		.catch(error=>console.log(error));
	}
        function loadForm(skillName) {

        fetch(`/@Model.ControllerForGetSkillForm/@Model.ActionForGetSkillForm?skillName=${encodeURIComponent(skillName)}`)
        .then(response => response.text())
        .then(html => {
            let form = document.getElementById('@CandidateSkillFormsId');
			let newDiv = document.createElement('div');
			newDiv.innerHTML = html;
            form.append(newDiv);
			countOfRequiredSkills++;
			selectedSkills.push(skillName);
			let skillsSelector = document.getElementById('@CandidateSkillTypeSelectorId');
			let option = skillsSelector.querySelector(`option:checked`);
			skillsSelector.removeChild(option);
			deactivateSubmitButton();
            executeScriptsInContainer(form);
        })
        .catch(error => console.log('Error:', error));
    }
</script>