<script>
	let bufferForAddedSkills = [];
	let countOfRequiredSkills = 0;
	let partsOfAddedPeriod = ['', ''];

	function onAddedTextChanged2(newValue, skillId) {
		clearTimeout(timeout);

		timeout = setTimeout(() => {

			addUpdateInAddedSkillBuffer2(newValue, skillId)

		}, 500);
	}

	function addDatePeriodUpdateInAddedSkillBuffer3(newValue, index, skillId){
		let item = bufferForAddedSkills.find(item=>item.SkillId === skillId);
		if(typeof item !== 'undefined'){
			if(partsOfAddedPeriod[index] === '') countOfRequiredSkills--;
			partsOfAddedPeriod[index] = newValue;
			item.Value = partsOfAddedPeriod.join('@Separators.DatePeriodSeparator');
			if(countOfRequiredSkills == 0) activateSubmitButton();
		}
		else{
			partsOfPeriod[index] = newValue;
			let currentData = {
				SkillId: skillId,
				Value: partsOfPeriod.join('@Separators.DatePeriodSeparator')
			};
			bufferForAddedSkills.push(currentData);
		}
	}

	function addUpdateInAddedSkillBuffer2(newValue, skillId) {

		let currentData = {
			SkillId: skillId,
			Value: newValue
		};

		let item = bufferForAddedSkills.find(item=>item.SkillId === skillId);
		if(typeof item !== 'undefined'){
			item.value = newValue;
		}
		else{
			countOfRequiredSkills--;
			bufferForAddedSkills.push(currentData);
			if(countOfRequiredSkills == 0) activateSubmitButton();
		}
	}

	function removeAddedValuedSkill2(skillId, skillName)
	{
		bufferForAddedSkills = bufferForAddedSkills.filter(x=>x.SkillId !== skillId);
		selectedSkills = selectedSkills.filter(x=>x != skillName);
		document.getElementById(skillId).remove();
		let skillsSelector = document.getElementById('@CandidateSkillTypeSelectorId');
		let newOption = document.createElement('option');
		newOption.value = skillName;
		newOption.textContent = skillName;
		skillsSelector.append(newOption);
		if(countOfRequiredSkills !== 0){
			countOfRequiredSkills--;
			if(countOfRequiredSkills == 0) activateSubmitButton();
		}
	}
</script>

<script>
	let bufferForUpdatingSkills = @Json.Serialize(skillsDTOs);
	let selectedSkills = @Json.Serialize(Model.CandidateSkills.Select(x => x.Skill.Name));
	let timeout = null;
	let partsOfUpdatingPeriod = ['', ''];

	function onUpdatingTextChanged2(newValue, skillId) {
		clearTimeout(timeout);

		timeout = setTimeout(() => {

			addUpdateInUpdatingSkillBuffer2(newValue, skillId)

		}, 500);
	}

	function addDatePeriodUpdateInUpdatingSkillBuffer3(newValue, index, valuedSkillId){
		let item = bufferForUpdatingSkills.find(item=>item.ValuedSkillId === valuedSkillId);
		if(typeof item !== 'undefined'){
			if(partsOfUpdatingPeriod[index] === '') countOfRequiredSkills--;
			partsOfUpdatingPeriod[index] = newValue;
			item.Value = partsOfUpdatingPeriod.join('@Separators.DatePeriodSeparator');
			if(countOfRequiredSkills == 0) activateSubmitButton();
		}
		else{
			partsOfUpdatingPeriod[index] = newValue;
			let currentData = {
				ValuedSkillId: skillId,
				Value: partsOfUpdatingPeriod.join('@Separators.DatePeriodSeparator')
			};
			bufferForUpdatingSkills.push(currentData);
		}
	}

	function addUpdateInUpdatingSkillBuffer2(newValue, valuedSkillId) {

		let currentData = {
			ValuedSkillId: valuedSkillId,
			Value: newValue
		};

		let item = bufferForUpdatingSkills.find(item=>item.ValuedSkillId === valuedSkillId);
		if(typeof item !== 'undefined'){
			item.value = newValue;
		}
		else{
			bufferForUpdatingSkills.push(currentData);
		}
	}

	function removeUpdatingValuedSkill2(valuedSkillId, skillName)
	{
		bufferForUpdatingSkills = bufferForUpdatingSkills.filter(x=>x.ValuedSkillId !== valuedSkillId);
		selectedSkills = selectedSkills.filter(x=>x != skillName);
		document.getElementById(valuedSkillId).remove();
		let skillsSelector = document.getElementById('@CandidateSkillTypeSelectorId');
		let newOption = document.createElement('option');
		newOption.value = skillName;
		newOption.textContent = skillName;
		skillsSelector.append(newOption);
	}

	function loadSkills(prefix){
		fetch(`/@Model.ControllerForGetSkillsNames/@Model.ActionForGetSkillsNames?prefix=${encodeURIComponent(prefix)}`, {
			method: 'GET',
			headers: {
				'Accept': 'application/json'
			}
		})
		.then(response => response.json())
		.then(data=>{
			let select = document.getElementById('@CandidateSkillTypeSelectorId');

			data = data.filter(x=>selectedSkills.indexOf(x) === -1);

			select.innerHTML = '<option hidden disapbled selected value="">Элементы</option>' + data
			.map(item => `<option value="${item}">${item}</option>`)
			.join('');
		})
		.catch(error=>console.log(error));
	}
	function loadForm(skillName) {
		fetch(`/@Model.ControllerForGetSkillForm/@Model.ActionForGetSkillForm?skillName=${encodeURIComponent(skillName)}&eventsHandlers=${encodeURIComponent(JSON.stringify(@Json.Serialize(addedSkillsEventsHandler)))}`)
		.then(response => response.text())
		.then(html => {
			let form = document.getElementById('@CandidateSkillFormsId');
			let newDiv = document.createElement('div');
			newDiv.innerHTML = html;
			form.append(newDiv);
			countOfRequiredSkills++;
			selectedSkills.push(skillName);
			let skillsSelector = document.getElementById('@CandidateSkillTypeSelectorId');
			let option = skillsSelector.querySelector(`option:checked`);
			skillsSelector.removeChild(option);
			deactivateSubmitButton();
			executeScriptsInContainer(form);
		})
		.catch(error => console.log('Error:', error));
	}
</script>