@model ViewPositionsPageDTO
@{
	
}
<form>
	<menu class="d-flex flex-row list-unstyled">
		<li class="ms-1">
			<button type="submit" asp-controller="@Model.ControllerForDeletePositions" asp-action="@Model.ActionForDeletePositions"
					data-bs-toggle="tooltip" data-bs-placement="top"
					data-bs-title="Delete all selected positions"
					class="btn btn-outline-danger">
				<i class="bi bi-trash3"></i>
			</button>
		</li>
	</menu>
<table class="table">
	<thead>
		<tr>
			<th><input type="checkbox" id="selectAll" /></th>
			<th>@(nameof(Position.Title))</th>
			<th>@(nameof(Position.Description))</th>
			<th>@(nameof(Position.PositionSkills))</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var position in Model.Positions)
		{
			<tr>
				<td>
					<input type="checkbox" class="item" name="positions" value="@position.Id" />
				</td>
				<td>
					<a asp-controller="@Model.ControllerForEditPosition" asp-action="@Model.ActionForEditPosition" asp-route-positionId="@position.Id">@position.Title</a>
				</td>
				<td>
					@MarkdownTextFormater.Render(position.Description)
				</td>
				<td>
					@foreach (var skill in position.PositionSkills.Take(10))
					{
						<label>@skill.Skill.Name</label>
					}
				</td>
			</tr>
		}
	</tbody>
</table>
</form>
<script>
	const selectAll = document.getElementById('selectAll');
	const items = document.querySelectorAll('.item');
	selectAll.addEventListener('change', () => {
		items.forEach(item => {
			item.checked = selectAll.checked;
		});
	});
	items.forEach(item => {
	item.addEventListener('change', () => {
		const allChecked = Array.from(items).every(el => el.checked);
		selectAll.checked = allChecked;
		});
	});
</script>
