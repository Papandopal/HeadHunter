@model RecruterHomePageDTO
@inject IUILocalizationFormater UILocalizationFormater
@{
	var partialModel = new ViewPositionsRecruterPageDTO
			{
				Positions = Model.Positions,
				ActionForAddPosition = Model.ActionForAddPosition,
				ControllerForAddPosition = Model.ControllerForAddPosition,
				ActionForDeletePositions = Model.ActionForDeletePositions,
				ControllerForDeletePositions = Model.ControllerForDeletePositions,
				ActionForViewPosition = Model.ActionForViewPosition,
				ControllerForViewPosition = Model.ControllerForViewPosition
			};
}
<label>@UILocalizationFormater.Format("Positions"):</label>
<partial name="Positions/PositionsView" model="@partialModel" />