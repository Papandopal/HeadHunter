@model CreateRecruterProfilePageDTO
@inject IUILocalizationFormater UILocalizationFormater
@{
	string submitButtonId = "submitButtonId";
	var formId = "formId";
}
<form id="@formId" asp-controller="@Model.ControllerForSubmit" asp-action="@Model.ActionForSubmit" method="post">
	<div class="d-flex flex-column">
		<label for="Name">@UILocalizationFormater.Format("Name"):</label>
		<input id="Name" asp-for="Name" onchange="addProperty('Name')" />
		<button id="@submitButtonId" disabled type="submit">@UILocalizationFormater.Format("Save")</button>
	</div>
</form>

<script>
	let propsCount = document.getElementById('@formId').querySelectorAll('input').length;
	if(propsCount==0) activateSubmitButton();
	let data = [];

	function activateSubmitButton(){
		document.getElementById("@submitButtonId").disabled = false;
	}

	function addProperty(propName) {
		let item = data.find(item => item === propName);
		if (typeof item === 'undefined') {
			propsCount--;
			data.push(propName);
		}
		if(propsCount==0) activateSubmitButton();
	}
</script>
