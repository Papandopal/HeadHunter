@model VerifyUserDTO
@{
	ViewData["Title"] = "Login";
}
<div class="d-flex justify-content-center align-items-center">
	<div class="w-25" style="min-width: 300px">
		<div class="text-center font-monospace m-5">
			<h1 style="font-family: Arial, sans-serif;">SIGN IN</h1>
		</div>
		<form method="post">
			<div class="input-group has-validation m-2">
				<div class="form-floating">
					<input type="email" asp-for="Email" class="form-control" id="floatingInputGrid" placeholder="name@gmail.com">
					<label for="floatingInputGrid">Email address</label>
				</div>
				<span class="input-group-text">@@</span>
			</div>
			<div class="input-group has-validation m-2">
				<div class="form-floating">
					<input type="password" asp-for="Password" class="form-control" id="floatingInputGrid" placeholder="**********">
					<label for="floatingInputGrid">Password</label>
				</div>
				<span class="input-group-text"> <i class="bi bi-eye"></i> </span>
			</div>
			<div class="d-flex justify-content-between m-4">
				<a asp-action="Registration" class="link-underline link-underline-opacity-0">Sign Up</a>
				<button type="submit" value="Verify" class="btn btn-outline-success">Sign in</button>
			</div>
			<div class="text-center m-2">
				<input type="checkbox" asp-for="RememberMe" />
				<label asp-for="RememberMe">Remember this device?</label>
			</div>
		</form>
	</div>
</div>
